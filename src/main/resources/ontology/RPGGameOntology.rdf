    <!-- http://www.semanticweb.org/vlady/ontologies/2026/4/RPG-game-ontology#Healer -->

    <owl:Class rdf:about="http://www.semanticweb.org/vlady/ontologies/2026/4/RPG-game-ontology#Healer">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/vlady/ontologies/2026/4/RPG-game-ontology#Player"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/vlady/ontologies/2026/4/RPG-game-ontology#Sword"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/vlady/ontologies/2026/4/RPG-game-ontology#usesWeapon"/>
                        <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/vlady/ontologies/2026/4/RPG-game-ontology#Dagger"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/vlady/ontologies/2026/4/RPG-game-ontology#wearsArmor"/>
                <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/vlady/ontologies/2026/4/RPG-game-ontology#LightArmor"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/vlady/ontologies/2026/4/RPG-game-ontology#usesWeapon"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


