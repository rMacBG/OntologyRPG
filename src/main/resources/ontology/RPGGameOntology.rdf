    <!-- http://www.semanticweb.org/vlady/ontologies/2026/4/RPG-game-ontology#belongsToFaction -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/vlady/ontologies/2026/4/RPG-game-ontology#belongsToFaction">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/vlady/ontologies/2026/4/RPG-game-ontology#belongsToFaction"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/vlady/ontologies/2026/4/RPG-game-ontology#Character"/>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:range>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/vlady/ontologies/2026/4/RPG-game-ontology#belongsToFaction"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/vlady/ontologies/2026/4/RPG-game-ontology#Faction"/>
            </owl:Restriction>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/vlady/ontologies/2026/4/RPG-game-ontology#completesQuest -->

