<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology/"
     xml:base="http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:Combat_Ontology="http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#"
     xmlns:RPG-game-ontology="http://www.semanticweb.org/vlady/ontologies/2026/4/RPG-game-ontology#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology">
        <owl:imports rdf:resource="http://www.semanticweb.org/vlady/ontologies/2026/4/RPG-game-ontology"/>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/vlady/ontologies/2026/4/RPG-game-ontology#belongsToFaction -->

    <rdf:Description rdf:about="http://www.semanticweb.org/vlady/ontologies/2026/4/RPG-game-ontology#belongsToFaction">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    </rdf:Description>
    


    <!-- http://www.semanticweb.org/vlady/ontologies/2026/4/RPG-game-ontology#hasElement -->

    <rdf:Description rdf:about="http://www.semanticweb.org/vlady/ontologies/2026/4/RPG-game-ontology#hasElement">
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#usesAttack"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/vlady/ontologies/2026/4/RPG-game-ontology#hasElement"/>
        </owl:propertyChainAxiom>
    </rdf:Description>
    


    <!-- http://www.semanticweb.org/vlady/ontologies/2026/4/RPG-game-ontology#usesWeapon -->

    <rdf:Description rdf:about="http://www.semanticweb.org/vlady/ontologies/2026/4/RPG-game-ontology#usesWeapon">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    </rdf:Description>
    


    <!-- http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#hasBaseAttack -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#hasBaseAttack">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#Attack"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#Attack"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#hasBehavior -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#hasBehavior">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#Behavior"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#hasStartingArmor -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#hasStartingArmor">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/vlady/ontologies/2026/4/RPG-game-ontology#Player"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/vlady/ontologies/2026/4/RPG-game-ontology#Armor"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#hasStartingSkill -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#hasStartingSkill">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/vlady/ontologies/2026/4/RPG-game-ontology#Player"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/vlady/ontologies/2026/4/RPG-game-ontology#Skill"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#hasStartingWeapon -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#hasStartingWeapon">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/vlady/ontologies/2026/4/RPG-game-ontology#Player"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/vlady/ontologies/2026/4/RPG-game-ontology#Weapon"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#hasWeapon -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#hasWeapon">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/vlady/ontologies/2026/4/RPG-game-ontology#Weapon"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#strongAgainst -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#strongAgainst">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#usableByClass -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#usableByClass">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/vlady/ontologies/2026/4/RPG-game-ontology#Player"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#usesAttack -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#usesAttack">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#weakAgainst -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#weakAgainst">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#hasActiveRounds -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#hasActiveRounds">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/vlady/ontologies/2026/4/RPG-game-ontology#Skill"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#hasBaseDamage -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#hasBaseDamage">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#hasBaseDef -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#hasBaseDef">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/vlady/ontologies/2026/4/RPG-game-ontology#Armor"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#hasBaseMana -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#hasBaseMana">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/vlady/ontologies/2026/4/RPG-game-ontology#RobeArmor"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#hasCooldown -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#hasCooldown">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/vlady/ontologies/2026/4/RPG-game-ontology#Skill"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#hasDamageBonus -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#hasDamageBonus">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/vlady/ontologies/2026/4/RPG-game-ontology#Armor"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/vlady/ontologies/2026/4/RPG-game-ontology#Skill"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#hasDamagePenalty -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#hasDamagePenalty">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/vlady/ontologies/2026/4/RPG-game-ontology#Armor"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/vlady/ontologies/2026/4/RPG-game-ontology#Skill"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#hasDamageResistance -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#hasDamageResistance">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/vlady/ontologies/2026/4/RPG-game-ontology#Armor"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/vlady/ontologies/2026/4/RPG-game-ontology#Skill"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#hasDefBonus -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#hasDefBonus">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/vlady/ontologies/2026/4/RPG-game-ontology#Armor"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/vlady/ontologies/2026/4/RPG-game-ontology#Skill"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#hasHP -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#hasHP">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/vlady/ontologies/2026/4/RPG-game-ontology#Character"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#hasLevel -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#hasLevel">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/vlady/ontologies/2026/4/RPG-game-ontology#Armor"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/vlady/ontologies/2026/4/RPG-game-ontology#Character"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/vlady/ontologies/2026/4/RPG-game-ontology#Skill"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/vlady/ontologies/2026/4/RPG-game-ontology#Weapon"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#hasManaCost -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#hasManaCost">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#MagicAttack"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#AggressiveBehavior -->

    <owl:Class rdf:about="http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#AggressiveBehavior">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#Behavior"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#Attack -->

    <owl:Class rdf:about="http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#Attack"/>
    


    <!-- http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#Behavior -->

    <owl:Class rdf:about="http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#Behavior"/>
    


    <!-- http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#DefensiveBehavior -->

    <owl:Class rdf:about="http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#DefensiveBehavior">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#Behavior"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#Earth -->

    <owl:Class rdf:about="http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#Earth">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/vlady/ontologies/2026/4/RPG-game-ontology#Element"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#ElementalAttack -->

    <owl:Class rdf:about="http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#ElementalAttack">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#Attack"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/vlady/ontologies/2026/4/RPG-game-ontology#hasElement"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/vlady/ontologies/2026/4/RPG-game-ontology#Element"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#Attack"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#Fire -->

    <owl:Class rdf:about="http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#Fire">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/vlady/ontologies/2026/4/RPG-game-ontology#Element"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#Hit -->

    <owl:Class rdf:about="http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#Hit">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/vlady/ontologies/2026/4/RPG-game-ontology#Element"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#Ice -->

    <owl:Class rdf:about="http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#Ice">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/vlady/ontologies/2026/4/RPG-game-ontology#Element"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#Lightning -->

    <owl:Class rdf:about="http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#Lightning">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/vlady/ontologies/2026/4/RPG-game-ontology#Element"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#MagicAttack -->

    <owl:Class rdf:about="http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#MagicAttack">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#Attack"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#MeleeAttack -->

    <owl:Class rdf:about="http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#MeleeAttack">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#Attack"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#NeutralBehavior -->

    <owl:Class rdf:about="http://www.semanticweb.org/vlady/ontologies/2026/5/Combat_Ontology#NeutralBehavior">
